# 2140city.cn API
API_BASE=https://www.2140city.cn

# Optional: seed a known 2140 session for local testing.
CI_SESSION=

# Supabase: required for agent logs, memories, human chapters, tips, and event feeds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers.
# DEEPSEEK_API_KEY is used by GPT-X chat and scheduled agents.
DEEPSEEK_API_KEY=

# Legacy/unused unless a feature is wired to Anthropic later.
ANTHROPIC_API_KEY=

# 2140 system account used by public pages and scheduled agents.
AGENT_MOBILE=
AGENT_PASSWD_MD5=

# Vercel Cron bearer token for /api/cron.
CRON_SECRET=
